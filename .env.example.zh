# ============================================================
# Startidy 环境变量模板（中文说明版）
#
# 用法：
#   cp .env.example .env      # 然后编辑 .env，填入你自己的值
#
# 运行 startidy 时会自动读取当前目录下的 .env。
# 标注「必填」的变量必须填写；其余变量都已经有合理默认值，
# 只有想覆盖默认行为时才需要打开注释并修改。
# 命令行参数（如 --openai-key）优先级高于本文件。
#
# 英文原版见 .env.example。
# ============================================================


# ============================================================
# 1. GitHub 凭据（必填）
# ============================================================

# GitHub 个人访问令牌（Personal Access Token）。
# 作用：读取你点过 Star 的仓库列表，以及这些仓库的 README 内容。
# 需要的权限范围：repo、read:user
# 申请地址：https://github.com/settings/tokens → Generate new token (classic)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 你的 GitHub 用户名。
# 作用：决定整理「谁」的 Star 列表。
GITHUB_USERNAME=your-username


# ============================================================
# 2. AI 提供方
# ============================================================

# 用哪家 AI 来规划分类、给仓库归类。
#   openai = 任何兼容 OpenAI Chat Completions 接口的服务（默认）
#   gemini = Google Gemini
# 两边效果一致，有哪个 key 就用哪个。
AI_PROVIDER=openai

# 每分钟最多发起多少次 AI 请求，两个提供方共用（0 = 不限制）。
# 作用：Startidy 会在请求之间自动等待，避免触发服务商的限流；
# 内置重试逻辑也会在遇到 HTTP 429 时退避重试。
# 默认值：Gemini 15（免费额度）、OpenAI 不限制。
# AI_RPM=15

# 提供方专用覆盖项，仅在未设置 AI_RPM 时生效。
# OPENAI_RPM=60
# GEMINI_RPM=15

# --- 2a. OpenAI 兼容服务（AI_PROVIDER=openai 时生效） ---

# OpenAI 兼容接口的 API Key。（该模式下必填）
# 说明：本地服务（Ollama / LM Studio / vLLM）本身不校验 key，
# 但 dotenv 和 Startidy 仍要求非空，随便填一个字符串即可，例如 ollama。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容接口的地址（Base URL）。
# 作用：决定请求发往哪里，Startidy 会调用 POST {OPENAI_BASE_URL}/chat/completions。
# 常见取值：
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
#   vLLM        http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称。
# 作用：指定用哪个模型做分类，不同服务商的模型名不同：
#   OpenAI      gpt-4o-mini
#   DeepSeek    deepseek-chat
#   OpenRouter  openai/gpt-4o-mini
#   Groq        llama-3.3-70b-versatile
#   Ollama      llama3.1
OPENAI_MODEL=gpt-4o-mini

# 要求模型返回 JSON 的方式：
#   json_object = JSON 模式（默认）
#   json_schema = 严格结构化输出（仅部分服务商支持）
#   none        = 不使用 JSON 模式，直接解析文本
# 作用：兼容性开关。若服务商拒绝该参数，Startidy 会自动去掉参数重试一次。
# OPENAI_RESPONSE_FORMAT=json_object

# 单次请求超时时间（毫秒）。
# 作用：本地模型较慢时可以调大，避免请求被提前中断。
# OPENAI_TIMEOUT_MS=120000

# --- 2b. Google Gemini（AI_PROVIDER=gemini 时生效） ---

# Gemini 的 API Key。（该模式下必填）
# 申请地址：https://aistudio.google.com/app/apikey
# 若要用 Gemini：取消下面三行注释，并把 AI_PROVIDER 改成 gemini。
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini 使用的模型。
# 可选：gemini-2.5-flash、gemini-2.0-flash、gemini-1.5-pro
# GEMINI_MODEL=gemini-2.5-flash


# ============================================================
# 3. 分类规划
# ============================================================

# AI 最多可以创建多少个分类（默认 32）。
# 作用：控制分类的粗细。数值小 → 分类少而宽；数值大 → 分类多而细。
# MAX_CATEGORIES=32

# 分类名没有长度限制：已经不依赖 GitHub List 的名称规则，
# AI 可以直接使用「windows工具」「阅读/小说/epub/漫画」这样的中文短名。
# 只有生成的文件名受文件系统限制，过长时会在磁盘上截断，文件内部仍保留完整名称。
# （CATEGORY_NAME_MAX_LENGTH、LIST_NAME_MAX_LENGTH 已不再使用。）

# 一个仓库最多可以归入几个分类（默认 3）。
# 作用：适合同时涉及多个主题的仓库（例如既是工具又是框架）。
# MAX_CATEGORIES_PER_REPO=3

# 一个仓库最少归入几个分类（默认 1）。
# MIN_CATEGORIES_PER_REPO=1


# ============================================================
# 4. 批处理
# ============================================================

# 每次发给 AI 的仓库数量（默认 20）。
# 作用：批量越大 → 请求次数和费用越少，但单次提示词更长，
# 也更容易撞到输出 token 上限。
# CLASSIFY_BATCH_SIZE=20

# 并发从 GitHub 拉取多少个仓库的 README（默认 20）。
# 作用：影响拉取速度，过大可能触发 GitHub 速率限制。
# README_BATCH_SIZE=20

# 每批分类请求之间的间隔（毫秒，默认 2000）。
# 作用：遇到服务商限流时可调大，请求更平缓。
# BATCH_DELAY=2000

# 每个仓库的 README 最多截取多少字符发给 AI（默认 10000）。
# 作用：调小可省 token；调大有助于冷门项目的分类准确度。
# README_MAX_LENGTH=10000

# 单个仓库分类流程中的同类上限（默认 10000）。
# README_MAX_LENGTH_SINGLE=10000


# ============================================================
# 5. 模型参数
# ============================================================

# 规划分类时的温度（默认 0.7）。
# 作用：越大分类名越有创意、越多样；越小越稳定保守。
# AI_TEMPERATURE_PLANNING=0.7

# 归类仓库时的温度（默认 0.3）。
# 作用：归类需要一致性，建议保持较小值。
# AI_TEMPERATURE_CLASSIFY=0.3

# 规划分类时的最大输出 token 数（默认：Gemini 65536，OpenAI 8192）。
# 作用：分类很多时可调大，避免输出被截断。
# AI_MAX_TOKENS_PLANNING=8192

# 归类仓库时的最大输出 token 数（默认：Gemini 65536，OpenAI 8192）。
# 作用：批量很大时输出会变长，可适当调大。
# AI_MAX_TOKENS_CLASSIFY=8192


# ============================================================
# 6. 输出
# ============================================================

# 生成 Markdown 文件的目录（默认 stars）。
# 作用：目录内会生成索引 README.md，以及每个分类一个 <分类名>.md。
# 可以指向你手工维护的仓库目录：没有 <!-- startidy:... --> 标记的文件
# 不会被修改或删除。
# OUTPUT_DIR=stars


# ============================================================
# 7. 重试
# ============================================================

# AI / GitHub 请求失败后的最大重试次数（默认 3）。
# 作用：遇到限流（429）、服务端错误（5xx）、408、409 时会自动重试，
# 采用指数退避，并优先遵守响应里的 Retry-After 头。
# MAX_RETRIES=3

# 两次重试之间的基础等待时间（毫秒，默认 1000）。
# RETRY_DELAY=1000


# ============================================================
# 8. 调试
# ============================================================

# 输出详细日志（默认 false）。
# 作用：打印每一批正在处理的仓库，便于排查分类异常。
# DEBUG=false

# 打印 AI 接口的原始响应（默认 false）。
# 作用：模型返回的 JSON 格式不对时，用它定位问题。
# LOG_API_RESPONSES=false
