# ============================================================
# Startidy - environment template
#
# Usage:
#   cp .env.example .env      # then edit .env and fill in your values
#
# `.env` is loaded automatically when you run `startidy`.
# Variables marked (required) must be set; everything else already
# has a sensible default and only needs to be set to override it.
# Command-line flags (e.g. --openai-key) always win over this file.
#
# Chinese version with the same variables: .env.example.zh
# ============================================================


# ============================================================
# 1. GitHub credentials (required)
# ============================================================

# GitHub Personal Access Token.
# Used to read your starred repositories and their README files.
# Required token scopes: repo, read:user
# Create one at: https://github.com/settings/tokens  ("Generate new token (classic)")
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Your GitHub username (the account whose Stars should be organized).
GITHUB_USERNAME=your-username


# ============================================================
# 2. AI provider
# ============================================================

# Which AI backend plans your categories and classifies repositories.
#   openai = any OpenAI-compatible Chat Completions API (DEFAULT)
#   gemini = Google Gemini
# Both providers produce identical results; pick whichever you have a key for.
AI_PROVIDER=openai

# Maximum AI requests per minute, shared by BOTH providers (0 = no limit).
# Startidy spaces requests out so you stay under the provider's rate limit;
# the built-in retry logic also backs off on HTTP 429.
# Defaults: Gemini 15 (free tier), OpenAI unlimited.
# AI_RPM=15

# Provider-specific override, used when AI_RPM is not set.
# OPENAI_RPM=60
# GEMINI_RPM=15

# --- 2a. OpenAI-compatible provider (AI_PROVIDER=openai) ---

# API key for the OpenAI-compatible endpoint. (required for this provider)
# Local servers (Ollama / LM Studio / vLLM) ignore the key, but dotenv and
# Startidy still require a non-empty value - any string works, e.g. `ollama`.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Base URL of the OpenAI-compatible endpoint.
# Startidy calls `POST {OPENAI_BASE_URL}/chat/completions`.
# Examples:
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
#   vLLM        http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name to send in the request.
#   OpenAI      gpt-4o-mini
#   DeepSeek    deepseek-chat
#   OpenRouter  openai/gpt-4o-mini
#   Groq        llama-3.3-70b-versatile
#   Ollama      llama3.1
OPENAI_MODEL=gpt-4o-mini

# How the model is asked to return JSON:
#   json_object = JSON mode (default)
#   json_schema = strict structured output (only on providers that support it)
#   none        = no JSON mode, parse the plain text response
# If a provider rejects this parameter, Startidy retries once without it.
# OPENAI_RESPONSE_FORMAT=json_object

# Request timeout in milliseconds. Raise it for slow local models.
# OPENAI_TIMEOUT_MS=120000

# --- 2c. Embeddings for the optional taxonomy agent ---
# Set EMBEDDING_MODEL explicitly to enable embedding-based taxonomy review.
# The embedding client is disabled when this variable is omitted.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# --- 2b. Google Gemini provider (AI_PROVIDER=gemini) ---

# Gemini API key. (required when AI_PROVIDER=gemini)
# Get one at: https://aistudio.google.com/app/apikey
# If you use Gemini, uncomment the three lines below and set AI_PROVIDER=gemini.
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini model to use.
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
# GEMINI_MODEL=gemini-2.5-flash


# ============================================================
# 3. Category planning
# ============================================================

# Maximum number of categories the AI may create.
# Fewer categories = broader buckets; more = finer separation (default: 32).
# MAX_CATEGORIES=32

# Category names have no length limit: they are no longer tied to GitHub List
# names, so the AI may use labels such as `windows工具` or `阅读/小说/epub/漫画`
# as-is. The generated file name is capped only by file-system limits, and long
# names are truncated on disk while the file keeps the full name inside.
# (CATEGORY_NAME_MAX_LENGTH and LIST_NAME_MAX_LENGTH are no longer used.)

# How many categories a single repository may be filed into (default: 3).
# Useful for repositories that fit several topics at once.
# MAX_CATEGORIES_PER_REPO=3

# Minimum categories per repository (default: 1).
# MIN_CATEGORIES_PER_REPO=1


# ============================================================
# 4. Batch processing
# ============================================================

# How many repositories are sent to the AI in one classification request.
# Larger batches = fewer requests and lower cost, but bigger prompts
# (and a higher chance of hitting output-token limits). (default: 20)
# CLASSIFY_BATCH_SIZE=20

# How many repository READMEs are fetched from GitHub concurrently. (default: 20)
# README_BATCH_SIZE=20

# Pause between classification batches, in milliseconds (default: 2000).
# Raise it if you hit provider rate limits.
# BATCH_DELAY=2000

# Maximum number of characters of each README that is sent to the AI (default: 10000).
# Lower it to save tokens; raise it for better classification of niche projects.
# README_MAX_LENGTH=10000


# ============================================================
# 5. Model parameters
# ============================================================

# Temperature while planning categories (default: 0.7).
# Higher = more creative/varied category names, lower = more consistent.
# AI_TEMPERATURE_PLANNING=0.7

# Temperature while classifying repositories (default: 0.3).
# Classification benefits from consistency, so keep it low.
# AI_TEMPERATURE_CLASSIFY=0.3

# Maximum output tokens for category planning (default: Gemini 65536, OpenAI 8192).
# AI_MAX_TOKENS_PLANNING=8192

# Maximum output tokens for classification (default: Gemini 65536, OpenAI 8192).
# AI_MAX_TOKENS_CLASSIFY=8192


# ============================================================
# 6. Output
# ============================================================

# Directory that receives the generated Markdown files (default: stars).
# It contains an index `README.md` plus one `<Category>.md` per category.
# Safe to point at a repository you also edit by hand: files without the
# `<!-- startidy:... -->` marker are never modified or deleted.
# OUTPUT_DIR=stars


# ============================================================
# 7. Retries
# ============================================================

# How many times a failed AI/API request is retried (default: 3).
# Rate-limit (429), server (5xx), 408 and 409 responses are retried with
# exponential backoff, honoring the `Retry-After` header when present.
# MAX_RETRIES=3

# Base delay between retries, in milliseconds (default: 1000).
# RETRY_DELAY=1000


# ============================================================
# 8. Debugging
# ============================================================

# Verbose logging, including the batches being processed (default: false).
# DEBUG=false

# Log the raw AI API responses, useful when a model returns malformed JSON. (default: false)
# LOG_API_RESPONSES=false


# ============================================================
# 9. Taxonomy agent (embeddings)
# ============================================================

# Watches the classification run. After every batch it embeds the batch,
# compares it against the centroid of every category and asks the model to
# either add a category for repositories that fit nowhere or split a category
# whose members drifted apart. Repositories affected by a decision are queued
# and classified again against the new taxonomy. (default: true)
# AGENT_ENABLED=true

# Embedding endpoint. Defaults to the active AI provider and reuses
# OPENAI_BASE_URL / OPENAI_API_KEY (or GEMINI_API_KEY), so a separate service
# such as Ollama or vLLM needs only the four lines below.
# EMBEDDING_PROVIDER=openai        # openai (default) or gemini
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=text-embedding-3-small
#
# Local example:
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_MODEL=nomic-embed-text
# Gemini embedding example: EMBEDDING_PROVIDER=gemini, EMBEDDING_MODEL=text-embedding-004
#
# When no embedding model is configured, the agent is skipped with a note and
# the normal classification flow continues (embeddings are never required).

# Similarity (0-1) below which a repository counts as "fits no category"
# (default: 0.35). Raise it to make the agent propose more new categories.
# AGENT_SIMILARITY_THRESHOLD=0.35

# Similarity needed to group unclassified repositories into one candidate
# category (default: 0.72).
# AGENT_CLUSTER_SIMILARITY=0.72

# How far a category's two clusters must be apart (intra minus cross
# similarity) before the agent may propose a split (default: 0.18).
# AGENT_SPLIT_GAP=0.18

# Members a category needs before a split is considered (default: 6).
# AGENT_MIN_SPLIT_MEMBERS=6

# Members a new category (or a split part) needs to be created (default: 4).
# AGENT_MIN_NEW_MEMBERS=4

# Maximum decisions the agent may apply per batch (default: 2).
# AGENT_MAX_DECISIONS=2
