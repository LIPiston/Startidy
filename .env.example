# ============================================
# Required
# ============================================

# GitHub Personal Access Token (required)
# Scopes: repo, read:user
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub username (required)
GITHUB_USERNAME=your-username

# ============================================
# AI Provider
# ============================================

# Which AI provider to use (default: gemini)
# gemini = Google Gemini, openai = any OpenAI-compatible API (OpenAI, DeepSeek, OpenRouter, Ollama, vLLM, ...)
# AI_PROVIDER=gemini

# --- Set only the key that matches your AI_PROVIDER ---

# Google Gemini API Key (required when AI_PROVIDER=gemini)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI-compatible API Key (required when AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# OpenAI-compatible base URL (default: https://api.openai.com/v1)
# Examples: DeepSeek https://api.deepseek.com/v1, OpenRouter https://openrouter.ai/api/v1
# Local: Ollama http://localhost:11434/v1, LM Studio http://localhost:1234/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI-compatible model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# How responses are requested (default: json_object)
# json_object / json_schema / none - retried automatically if the server rejects it
# OPENAI_RESPONSE_FORMAT=json_object

# OpenAI-compatible request timeout in ms (default: 120000)
# OPENAI_TIMEOUT_MS=120000

# ============================================
# Category Settings
# ============================================

# Maximum number of categories (default: 32)
# MAX_CATEGORIES=32

# Maximum category name length (default: 20)
# CATEGORY_NAME_MAX_LENGTH=20
# (legacy alias: LIST_NAME_MAX_LENGTH)

# Maximum categories per repository (default: 3)
# MAX_CATEGORIES_PER_REPO=3

# Minimum categories per repository (default: 1)
# MIN_CATEGORIES_PER_REPO=1

# ============================================
# Batch Processing
# ============================================

# Repositories classified per batch (default: 20)
# CLASSIFY_BATCH_SIZE=20

# Concurrent README fetches (default: 20)
# README_BATCH_SIZE=20

# Delay between batches in ms (default: 2000)
# BATCH_DELAY=2000

# ============================================
# Rate Limiting
# ============================================

# Gemini requests per minute (default: 15, Free tier)
# Raise to 360 on a paid tier
# GEMINI_RPM=15

# ============================================
# Model Settings
# ============================================

# Gemini model (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
# GEMINI_MODEL=gemini-2.5-flash

# Category planning temperature (default: 0.7)
# Higher = more creative, lower = more consistent
# AI_TEMPERATURE_PLANNING=0.7

# Classification temperature (default: 0.3)
# Keep it low because classification favors consistency
# AI_TEMPERATURE_CLASSIFY=0.3

# Category planning max output tokens (default: Gemini 65536, OpenAI 8192)
# AI_MAX_TOKENS_PLANNING=8192

# Classification max output tokens (default: Gemini 65536, OpenAI 8192)
# AI_MAX_TOKENS_CLASSIFY=8192

# ============================================
# README Settings
# ============================================

# Maximum README length during batch classification (default: 10000)
# Lower it to save tokens
# README_MAX_LENGTH=10000

# Maximum README length during single classification (default: 10000)
# README_MAX_LENGTH_SINGLE=10000

# ============================================
# Output Settings
# ============================================

# Markdown output directory (default: stars)
# Writes a README.md index plus one <Category>.md per category
# OUTPUT_DIR=stars

# ============================================
# Retry Settings
# ============================================

# Maximum retry attempts (default: 3)
# MAX_RETRIES=3

# Delay between retries in ms (default: 1000)
# RETRY_DELAY=1000

# ============================================
# Debug Settings
# ============================================

# Debug mode (default: false)
# Set to true for verbose logging
# DEBUG=false

# API response logging (default: false)
# Set to true to log full API responses
# LOG_API_RESPONSES=false
